:root {
  font-family: Inter, Arial, sans-serif;
  color: #1f2937;
  background: #f3f7ff;
  line-height: 1.5;
  font-weight: 400;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: linear-gradient(135deg, #eef3ff, #f7f8ff);
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 1400px;
  margin: 0 auto;
  padding: 32px 20px 60px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  gap: 12px;
}

.topbar h1 {
  margin: 0;
  font-size: 2rem;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.message-box {
  padding: 12px 16px;
  background: #e0f2fe;
  border: 1px solid #bae6fd;
  border-radius: 10px;
  margin-bottom: 20px;
  color: #0f172a;
}

.layout {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}

.panel {
  background: #ffffff;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
}

.panel h2 {
  margin-top: 0;
  margin-bottom: 16px;
}

.form-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.form-grid input,
.form-grid textarea {
  width: 100%;
  border: 1px solid #dbe3f0;
  border-radius: 10px;
  padding: 12px 14px;
  background: #f8fafc;
}

.form-grid button,
.section-head button,
.job-card button,
.job-card a {
  border: none;
  border-radius: 10px;
  padding: 12px 14px;
  font-weight: 600;
  text-decoration: none;
  text-align: center;
}

.form-grid button,
.section-head button,
.job-card button {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
}

.job-card a {
  display: inline-block;
  background: #0f172a;
  color: #fff;
}

.list-section {
  margin-top: 32px;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}

.job-card {
  background: #fff;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
}

.badge {
  display: inline-block;
  background: #dbeafe;
  color: #1d4ed8;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 700;
  margin-bottom: 12px;
}

.company-name {
  color: #475569;
  font-weight: 600;
  margin-top: 0;
}

.job-card h3 {
  margin: 0 0 8px;
}

.job-card ul {
  margin: 12px 0 18px;
  padding-left: 18px;
}

@media (max-width: 640px) {
  .topbar,
  .section-head {
    flex-direction: column;
    align-items: flex-start;
  }
}
